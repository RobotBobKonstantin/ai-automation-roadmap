    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $json.lead ?? {};\n\nconst normalizedEmail =\n  typeof lead.email === 'string' && lead.email.trim()\n    ? lead.email.trim().toLowerCase()\n    : null;\n\nlet normalizedPhone =\n  typeof lead.phone === 'string'\n    ? lead.phone.replace(/\\D/g, '')\n    : '';\n\nif (/^8\\d{10}$/.test(normalizedPhone)) {\n  normalizedPhone = `7${normalizedPhone.slice(1)}`;\n}\n\nnormalizedPhone = normalizedPhone || null;\n\nconst filters = [];\n\nif (normalizedEmail) {\n  filters.push(`normalized_email.eq.${normalizedEmail}`);\n}\n\nif (normalizedPhone) {\n  filters.push(`normalized_phone.eq.${normalizedPhone}`);\n}\n\nreturn {\n  json: {\n    lead: {\n      ...lead,\n      normalized_email: normalizedEmail,\n      normalized_phone: normalizedPhone\n    },\n    duplicate_filter: `or=(${filters.join(',')})`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        448
      ],
      "id": "cf94fab3-90a5-41f5-b115-605d27500b20",
      "name": "Normalize Contacts"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body ?? {};\n\nconst cleanString = (value) => {\n  return typeof value === 'string' ? value.trim() : '';\n};\n\nconst lead = {\n  name: cleanString(body.name),\n  email: cleanString(body.email).toLowerCase(),\n  phone: cleanString(body.phone),\n  company: cleanString(body.company),\n  service: cleanString(body.service),\n  budget: body.budget ?? null,\n  message: cleanString(body.message),\n  source: cleanString(body.source)\n};\n\nconst missingFields = [];\n\nif (!lead.name) {\n  missingFields.push('name');\n}\n\nif (!lead.email && !lead.phone) {\n  missingFields.push('email_or_phone');\n}\n\nconst isValid = Boolean(\n  lead.name &&\n  (lead.email || lead.phone)\n);\n\nreturn {\n  json: {\n    lead,\n    validation: {\n      isValid,\n      missingFields\n    }\n  }\n};"
      },
